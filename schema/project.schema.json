{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "word",
            "time"
          ],
          "type": "string"
        },
        "offsetF": {
          "type": "integer"
        },
        "ref": {
          "additionalProperties": false,
          "properties": {
            "media": {
              "type": "string"
            },
            "wordIdx": {
              "type": "integer"
            }
          },
          "required": [
            "media",
            "wordIdx"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "Badge": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 24,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "tone": {
          "enum": [
            "ink",
            "paper",
            "accent"
          ]
        }
      },
      "required": [
        "text",
        "tone"
      ],
      "type": "object"
    },
    "Bubble": {
      "enum": [
        "think",
        "say",
        "exclaim",
        "question",
        "exclaims"
      ]
    },
    "CalloutProps": {
      "additionalProperties": false,
      "properties": {
        "accent": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "body",
        "accent"
      ],
      "type": "object"
    },
    "ChaptercardProps": {
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "chapter",
        "title",
        "subtitle"
      ],
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "description": "Cross-field rules are enforced by pipeline.project.validate(), NOT expressible here: srcOutF > srcInF; speech-track clips carry no anchor; within-track clips never overlap.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "duckDb": {
          "type": [
            "number",
            "null"
          ]
        },
        "gainDb": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "seams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "atF": {
                "minimum": 0,
                "type": "integer"
              },
              "fadeMs": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "atF",
              "fadeMs"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "srcInF": {
          "minimum": 0,
          "type": "integer"
        },
        "srcOutF": {
          "minimum": 1,
          "type": "integer"
        },
        "tlStartF": {
          "minimum": 0,
          "type": "integer"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        }
      },
      "required": [
        "id",
        "media",
        "srcInF",
        "srcOutF",
        "tlStartF"
      ],
      "type": "object"
    },
    "Costar": {
      "additionalProperties": false,
      "description": "A duo shot's second character, or an ensemble member: a cast profile id and its own look (ids as for the lead) and bubble.",
      "properties": {
        "bubble": {
          "$ref": "#/$defs/Bubble"
        },
        "character": {
          "minLength": 1,
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "move": {
          "type": "string"
        },
        "pose": {
          "type": "string"
        }
      },
      "required": [
        "character"
      ],
      "type": "object"
    },
    "EvidencecardProps": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "claim",
        "detail"
      ],
      "type": "object"
    },
