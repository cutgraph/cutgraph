{
  "name": "@cutgraph/ui",
  "private": true,
  "version": "0.2.0",
  "license": "FSL-1.1-ALv2",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "codegen": "json2ts ../schema/project.schema.json -o src/types/project.ts",
    "types:check": "npm run codegen && git diff --exit-code -- src/types/project.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
